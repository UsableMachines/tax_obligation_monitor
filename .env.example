# Tax Obligation Monitor - Environment Variables
# Copy to .env and fill in values

SECRET_KEY=change-me-to-a-random-string
DATABASE_URL=sqlite:///tax_monitor.db

# Kindo AI Agent (required for AI analysis)
KINDO_API_TOKEN=
KINDO_AGENT_ID=

# Optional
PORT=5000
SESSION_COOKIE_PATH=/
SESSION_COOKIE_SECURE=false
APP_GUNICORN_TIMEOUT=120
APP_AGENT_POLL_TIMEOUT_SEC=120
